PORT=3000
DATABASE_URL=postgres://postgres:Hossam@localhost:5432/csv_import_db
# Optional: rows inserted per SQL statement during CSV processing (default 200)
BATCH_SIZE=200

# For running the test suite (npm test), copy this file to .env.test and
# point DATABASE_URL at a SEPARATE database (e.g. csv_import_db_test).
# The integration tests TRUNCATE all tables between runs, so this must
# never be the same database as the one above.
